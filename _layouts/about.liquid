---
layout: default
---
<div class="post fn-home">
  <header class="fn-hero">
    <div class="fn-hero-copy">
      {% if page.eyebrow %}<p class="fn-mono fn-eyebrow">{{ page.eyebrow }}</p>{% endif %}
      <h1 class="fn-hero-title">
        {% if site.title == 'blank' %}
          {{ site.first_name }} {{ site.middle_name }} {{ site.last_name }}
        {% else %}
          {{ site.title }}
        {% endif %}
      </h1>
      <p class="fn-lede">{{ page.subtitle }}</p>
      {% if page.hero_links %}
        <div class="fn-links">
          {% for l in page.hero_links %}
            <a class="fn-btn{% if l.solid %} solid{% endif %}" href="{{ l.url | relative_url }}">{{ l.label }}</a>
          {% endfor %}
        </div>
      {% endif %}
    </div>
    {% if page.profile and page.profile.image %}
      <div class="fn-portrait">
        {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
        {%
          include figure.liquid loading="eager" path=profile_image_path class="img-fluid" sizes="(min-width: 768px) 320px, 70vw" alt=page.profile.image
          cache_bust=true
        %}
        {% if page.profile.more_info %}
          <div class="fn-mono fn-telemetry">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}
  </header>

  <article>
    <div class="clearfix">{{ content }}</div>

    <!-- Featured projects -->
    {% if page.featured_projects %}
      <div class="fn-section-head">
        <h2 class="fn-section-title">Projects</h2>
        <a class="fn-btn" href="{{ '/projects/' | relative_url }}">All projects →</a>
      </div>
      <div class="publications projects-list">
        <ol class="bibliography">
          {% assign sorted_projects = site.projects | sort: 'importance' %}
          {% for project in sorted_projects limit: page.featured_projects %}
            {% include projects_list.liquid %}
          {% endfor %}
        </ol>
      </div>
    {% endif %}

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2 class="fn-section-title">
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">News</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">selected publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% social_links %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
